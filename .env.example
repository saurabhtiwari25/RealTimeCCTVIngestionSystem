# Database Configuration
# For Docker Compose: postgresql://postgres:postgres@postgres:5432/camera_stream_db
# For Local Run: postgresql://postgres:postgres@localhost:5432/camera_stream_db
# Fallback to SQLite (e.g. sqlite:///./recordings/cameras.db) if PostgreSQL is not running
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/camera_stream_db

# MediaMTX Configuration
# MEDIAMTX_HOST is the host accessible by the client browser (e.g., localhost)
MEDIAMTX_HOST=localhost
# MEDIAMTX_API_URL is the internal API endpoint reachable from Python/Streamlit
# In Docker: http://mediamtx:9997 | Locally: http://localhost:9997
MEDIAMTX_API_URL=http://mediamtx:9997

# MediaMTX Ports
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_PORT=9997

# Application Storage & Logging
RECORDINGS_DIR=recordings
LOG_LEVEL=INFO
